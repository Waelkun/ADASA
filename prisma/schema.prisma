generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single-user profile (demo account, id = 1)
model Profile {
  id             Int      @id @default(1)
  displayName    String   @default("Nutra User")
  sex            String   @default("male") // male | female
  birthYear      Int      @default(1995)
  heightCm       Float    @default(175)
  activityLevel  String   @default("moderate") // sedentary | light | moderate | active | very_active
  goalType       String   @default("lose") // lose | maintain | gain
  kcalGoal       Int      @default(2100)
  proteinG       Int      @default(160)
  carbsG         Int      @default(190)
  fatG           Int      @default(70)
  waterGoalMl    Int      @default(2800)
  goalWeightKg   Float?
  workoutsPerWeek Int     @default(4)
  units          String   @default("metric") // metric | imperial
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Personal food catalogue ("My foods")
model Food {
  id           String   @id @default(cuid())
  name         String
  brand        String?
  servingSizeG Float?
  kcal100      Float
  protein100   Float
  carbs100     Float
  sugar100     Float?
  fat100       Float
  satFat100    Float?
  fiber100     Float?
  salt100      Float?
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  logs         FoodLog[]

  @@index([name, brand])
}

model FoodLog {
  id        String   @id @default(cuid())
  foodId    String?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name      String
  loggedAt  DateTime
  dayDate   String   // client-local YYYY-MM-DD
  mealType  String   @default("snack") // breakfast | lunch | dinner | snack
  grams     Float
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  source    String   @default("manual") // scan | manual | myfoods
  createdAt DateTime @default(now())

  @@index([dayDate])
}

model WeightLog {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD (one entry per day, upsert)
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(cuid())
  loggedAt  DateTime
  dayDate   String   // client-local YYYY-MM-DD
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([dayDate])
}

model Workout {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD
  muscleGroups  String // JSON string[] e.g. '["chest","triceps"]'
  durationMin   Int?
  note          String?
  createdAt     DateTime @default(now())

  @@index([date])
}
